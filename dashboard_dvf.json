    {
      "id": 3,
      "title": "Écart Maison / Appartement",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "\nWITH p AS (\n    SELECT type_bien, percentile_cont(0.5) WITHIN GROUP (ORDER BY prix_m2) AS median\n    FROM dvf.transactions\n    WHERE prix_m2_fiable AND type_bien IN ('Appartement', 'Maison') AND date_mutation >= (SELECT max(date_mutation) FROM dvf.transactions WHERE prix_m2_fiable) - INTERVAL '12 months'\n    GROUP BY type_bien\n)\nSELECT CURRENT_DATE::timestamptz AS time,\n       round((100.0 * ((SELECT median FROM p WHERE type_bien = 'Maison')\n                       / NULLIF((SELECT median FROM p WHERE type_bien = 'Appartement'), 0) - 1))::numeric, 1) AS value;\n",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "Prime de prix des maisons par rapport aux appartements, en %."
    },
