      "targets": [
        {
          "format": "time_series",
          "rawSql": "\nSELECT m.mois::timestamptz AS time,\n       q.libelle AS metric,\n       q.valeur AS value\nFROM dvf.marche_mensuel m\nCROSS JOIN LATERAL (VALUES ('P25', m.prix_m2_p25),\n                           ('Médiane', m.prix_m2_median),\n                           ('P75', m.prix_m2_p75)) AS q(libelle, valeur)\nWHERE m.type_bien = 'Appartement'\n  AND m.prix_m2_median IS NOT NULL\n  AND $__timeFilter(m.mois)\nORDER BY 1;\n",
          "refId": "A"
        }
      ],
