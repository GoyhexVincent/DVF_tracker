      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "\nSELECT CURRENT_DATE::timestamptz AS time,\n       round(percentile_cont(0.5) WITHIN GROUP (ORDER BY prix_m2))::int AS value\nFROM dvf.transactions\nWHERE prix_m2_fiable AND type_bien = 'Appartement' AND date_mutation >= (SELECT max(date_mutation) FROM dvf.transactions WHERE prix_m2_fiable) - INTERVAL '12 months';\n",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "currencyEUR"
        },
        "overrides": []
      },
      "description": "Médiane des prix au m² des ventes d'appartements sur les 12 derniers mois de données."
    },
